{
  "name": "armada-sound-export",
  "version": "1.0.0",
  "private": true,
  "description": "Static renderer for the game's Strudel sounds: renders the .strudel files to WAV with superdough (the Strudel audio engine) in Node, no browser required.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "patch-package",
    "render": "node render.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@strudel/core": "^1.2.6",
    "@strudel/mini": "^1.2.6",
    "@strudel/tonal": "^1.2.6",
    "@strudel/transpiler": "^1.2.6",
    "@strudel/webaudio": "^1.3.0",
    "node-web-audio-api": "^1.0.9",
    "superdough": "^1.3.0"
  },
  "devDependencies": {
    "patch-package": "^8.0.1"
  }
}
